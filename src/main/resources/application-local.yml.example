# 复制本文件为 application-local.yml 并填写真实值（该文件不会提交到 Git）
# 也可以改用环境变量：DB_URL、DB_USERNAME、DB_PASSWORD、JWT_SECRET
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/checkin_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your-db-password

jwt:
  secret: replace-with-a-long-random-string
